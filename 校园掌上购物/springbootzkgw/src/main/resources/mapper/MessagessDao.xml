<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.dao.MessagessDao">

    <resultMap type="com.entity.MessagessEntity" id="messagessMap">
                    <result property="id"    column="id"    />
                    <result property="addtime"    column="addtime"    />
                    <result property="userid"    column="userid"    />
                    <result property="username"    column="username"    />
                    <result property="content"    column="content"    />
                    <result property="cpicture"    column="cpicture"    />
                    <result property="reply"    column="reply"    />
                    <result property="rpicture"    column="rpicture"    />
            </resultMap>

    <select id="selectListVO"
            resultType="com.entity.vo.MessagessVO">
        SELECT * FROM messagess messagess
        <where> 1=1 ${ew.sqlSegment}</where>
    </select>

    <select id="selectVO"
            resultType="com.entity.vo.MessagessVO">
        SELECT messagess.* FROM messagess messagess
        <where> 1=1 ${ew.sqlSegment}</where>
    </select>

    <select id="selectListView"
            resultType="com.entity.view.MessagessView">

        SELECT messagess.* FROM messagess messagess
        <where> 1=1 ${ew.sqlSegment}</where>
    </select>

    <select id="selectView"
            resultType="com.entity.view.MessagessView">
        SELECT * FROM messagess messagess
        <where> 1=1 ${ew.sqlSegment}</where>
    </select>

</mapper>